<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<!--
  VISTA en FXML: describe QUÉ hay en la ventana y CÓMO se coloca. No hay ni una
  línea de lógica. Se puede abrir y editar visualmente con Scene Builder.

  fx:controller="..."  clase que atiende los eventos de esta vista
  fx:id="lblValor"     el FXMLLoader mete este Label en el atributo @FXML lblValor del controlador
  onAction="#metodo"   método @FXML del controlador que se ejecuta al pulsar el botón
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mvc.contadorfxml.controlador.ControladorContador"
            prefWidth="300" prefHeight="200">
    <center>
        <Label fx:id="lblValor" text="0">
            <font>
                <Font name="System Bold" size="48"/>
            </font>
        </Label>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="+" onAction="#incrementar"/>
            <Button text="Reset" onAction="#reiniciar"/>
        </HBox>
    </bottom>
</BorderPane>
